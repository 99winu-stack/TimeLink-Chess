<Window x:Class="GameUI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameUI"
        mc:Ignorable="d"
        Title="Time Link Chess" MinWidth="1200" MinHeight="800"
        Icon="/Assets/icon.ico"
        WindowStartupLocation="CenterScreen"
        Background="Black"
        KeyDown="Window_KeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- left panel allow board selection and show game information -->
        <Border Grid.Column="0"
                x:Name="GamePanelLeft"
                Margin="10"
                CornerRadius="15"
                Background="{StaticResource FillColor}"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Name="BoardSelector">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Name="MainBoardButton"
                        Grid.Row="0"
                            Content="Main Board"
                            Margin="10"
                            Style="{StaticResource ButtonStyle}"
                            Click="MainBoard_Click"/>

                    <Button Name="TimelineWhiteButton"
                            Grid.Row="1"
                            Content="Timeline White"
                            Margin="10"
                            Style="{StaticResource ButtonStyle}"
                            Click="TimelineWhite_Click"/>

                    <Button Name="TimelineBlackButton"
                            Grid.Row="2"
                            Content="Timeline Black"
                            Margin="10"
                            Style="{StaticResource ButtonStyle}"
                            Click="TimelineBlack_Click"/>
                </Grid>

                <Grid Grid.Row="1"
                      Name="GameInfo"
                      Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="GAME STATUS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="5,5,5,15"/>

                    <Border Grid.Row="1"
                            Padding="15"
                            Margin="5"
                            CornerRadius="10"
                            Background="{StaticResource FillColor}">

                        <StackPanel>
                            <TextBlock Text="Current Player"
                                       FontSize="13"
                                       Foreground="LightGray"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="CurrentPlayerText"
                                       Text="White"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="White"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2"
                            Padding="15"
                            Margin="5,10,5,5"
                            CornerRadius="10"
                            Background="{StaticResource FillColor}">

                        <StackPanel>
                            <TextBlock Text="Game State"
                                       FontSize="13"
                                       Foreground="LightGray"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="GameStatusText"
                                       Text="Game in progress"
                                       FontSize="16"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3"
                            Padding="15"
                            Margin="5,10,5,5"
                            CornerRadius="10"
                            Background="{StaticResource FillColor}">

                        <StackPanel>
                            <TextBlock Text="Selected Board"
                                       FontSize="13"
                                       Foreground="LightGray"
                                       Margin="0,0,0,8"/>

                            <TextBlock x:Name="BoardPlayerText"
                                       Text="White to move"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       Margin="0,0,0,12"/>

                            <TextBlock Text="Check Status"
                                       FontSize="13"
                                       Foreground="LightGray"
                                       Margin="0,0,0,5"/>

                            <TextBlock x:Name="BoardCheckText"
                                       Text="No check"
                                       FontSize="16"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Grid>
        </Border>
        <!-- board -->
        <Border Grid.Column="1"
                Margin="10">
            <Viewbox>
                <Grid x:Name="BoardGrid"
                  Width="600"
                  Height="600"
                  MouseDown="BoardGrid_MouseDown">
                    <Grid.Background>
                        <ImageBrush ImageSource="/Assets/board.png"></ImageBrush>
                    </Grid.Background>

                    <UniformGrid x:Name="HighLightGrid"
                             Rows="8"
                             Columns="8">
                    </UniformGrid>

                    <UniformGrid x:Name="PieceGrid"
                             Rows="8"
                             Columns="8"
                             RenderOptions.BitmapScalingMode="HighQuality">
                    </UniformGrid>

                    <ContentControl x:Name="MenuContainer"/>
                </Grid>
            </Viewbox>
        </Border>
        <!-- right panel shows history of current boards and game controls-->
        <Border Grid.Column="2"
                x:Name="GamePanelRight"
                Margin="10"
                CornerRadius="15"
                Background="{StaticResource FillColor}"
                HorizontalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <ListBox x:Name="MoveHistoryList"
                         Grid.Row="0"
                         Margin="10"
                         Style="{StaticResource ListStyle}"
                         Width="auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         SelectionChanged="MoveHistoryList_SelectionChanged">
                </ListBox>

                <Grid Grid.Row="1"
                      Name="GameOptions"
                      Margin="15">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="GAME OPTIONS"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="White"
                               Margin="5,5,5,15"/>

                    <StackPanel Grid.Row="1"
                                Margin="5">

                        <Button x:Name="ResignButton"
                                Content="Resign"
                                Style="{StaticResource ButtonStyle}"
                                Margin="0,5"
                                Padding="10"
                                Click="ResignButton_Click"/>

                        <Button x:Name="OfferDrawButton"
                                Content="Offer Draw"
                                Style="{StaticResource ButtonStyle}"
                                Margin="0,5"
                                Padding="10"
                                Click="OfferDrawButton_Click"/>

                    </StackPanel>

                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>